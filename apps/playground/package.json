{
  "name": "@catrolling/playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:watch": "vitest --config ../../vitest.config.ts",
    "dev": "vite dev",
    "preview": "vite preview"
  },
  "dependencies": {
    "@catrolling/ui-schema-core": "workspace:*",
    "@catrolling/ui-schema-svelte": "workspace:*",
    "svelte": "^5.39.6"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.3",
    "svelte-check": "^4.3.3"
  }
}
